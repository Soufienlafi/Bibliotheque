{{ form_start(form) }}
    <div class="row">
        <div class="col-md-8">{{ form_row(form.title) }}</div>
        <div class="col-md-4">{{ form_row(form.isbn) }}</div>
    </div>

    {{ form_row(form.description) }}

    <div class="row">
        <div class="col-md-6">{{ form_row(form.publicationDate) }}</div>
        <div class="col-md-6">{{ form_row(form.quantity) }}</div>
    </div>

    <div class="row">
        <div class="col-md-6">{{ form_row(form.category) }}</div>
        <div class="col-md-6">{{ form_row(form.publisher) }}</div>
    </div>

    {{ form_row(form.authors) }}

    <button type="submit" class="btn btn-primary">{{ button_label|default('Save') }}</button>
    <a href="{{ path('app_book_index') }}" class="btn btn-outline-secondary">Cancel</a>
{{ form_end(form) }}