{% extends 'base.html.twig' %}

{% block title %}Borrowing index{% endblock %}

{% block body %}
    <h1>Borrowing index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>BorrowedAt</th>
                <th>DueDate</th>
                <th>ReturnedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for borrowing in borrowings %}
            <tr>
                <td>{{ borrowing.id }}</td>
                <td>{{ borrowing.borrowedAt ? borrowing.borrowedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ borrowing.dueDate ? borrowing.dueDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ borrowing.returnedAt ? borrowing.returnedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_borrowing_show', {'id': borrowing.id}) }}">show</a>
                    <a href="{{ path('app_borrowing_edit', {'id': borrowing.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_borrowing_new') }}">Create new</a>
{% endblock %}
