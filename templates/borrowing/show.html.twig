{% extends 'base.html.twig' %}

{% block title %}Borrowing{% endblock %}

{% block body %}
    <h1>Borrowing</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ borrowing.id }}</td>
            </tr>
            <tr>
                <th>BorrowedAt</th>
                <td>{{ borrowing.borrowedAt ? borrowing.borrowedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DueDate</th>
                <td>{{ borrowing.dueDate ? borrowing.dueDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ReturnedAt</th>
                <td>{{ borrowing.returnedAt ? borrowing.returnedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_borrowing_index') }}">back to list</a>

    <a href="{{ path('app_borrowing_edit', {'id': borrowing.id}) }}">edit</a>

    {{ include('borrowing/_delete_form.html.twig') }}
{% endblock %}
