{% extends 'base.html.twig' %}

{% block title %}{{ author.fullName }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">{{ author.fullName }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_author_index') }}" class="btn btn-outline-secondary">Back to list</a>
            <a href="{{ path('app_author_edit', {'id': author.id}) }}" class="btn btn-primary">Edit</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th style="width: 200px;">Id</th>
                        <td>{{ author.id }}</td>
                    </tr>
                    <tr>
                        <th>Full name</th>
                        <td>{{ author.fullName }}</td>
                    </tr>
                    <tr>
                        <th>Biography</th>
                        <td>
                            {% if author.biography %}
                                {{ author.biography|nl2br }}
                            {% else %}
                                <span class="text-muted">No biography provided.</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Number of books</th>
                        <td>{{ author.books|length }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <h2 class="h5">Books</h2>
    {% if author.books is empty %}
        <p class="text-muted">No books yet.</p>
    {% else %}
        <ul class="list-group mb-4">
            {% for book in author.books %}
                <li class="list-group-item">
                    <a href="{{ path('app_book_show', {'id': book.id}) }}">{{ book.title }}</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {{ include('author/_delete_form.html.twig') }}
</div>
{% endblock %}