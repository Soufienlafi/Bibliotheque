{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">{{ form_row(form.user) }}</div>
        <div class="col-md-6">{{ form_row(form.book) }}</div>
    </div>
    <div class="row">
        <div class="col-md-4">{{ form_row(form.reservedAt) }}</div>
        <div class="col-md-4">{{ form_row(form.expiresAt) }}</div>
        <div class="col-md-4">{{ form_row(form.status) }}</div>
    </div>

    <button type="submit" class="btn btn-primary">{{ button_label|default('Save') }}</button>
    <a href="{{ path('app_reservation_index') }}" class="btn btn-outline-secondary">Cancel</a>
{{ form_end(form) }}