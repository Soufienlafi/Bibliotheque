{% extends 'base.html.twig' %}

{% block title %}Reservation{% endblock %}

{% block body %}
    <h1>Reservation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reservation.id }}</td>
            </tr>
            <tr>
                <th>ReservedAt</th>
                <td>{{ reservation.reservedAt ? reservation.reservedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ExpiresAt</th>
                <td>{{ reservation.expiresAt ? reservation.expiresAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ reservation.status }}</td>
                {% set colors = {pending: 'warning', fulfilled: 'success', cancelled: 'secondary', expired: 'danger'} %}
                <span class="badge bg-{{ colors[reservation.status] ?? 'light' }}">{{ reservation.status|capitalize }}</span>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reservation_index') }}">back to list</a>

    <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">edit</a>

    {{ include('reservation/_delete_form.html.twig') }}
{% endblock %}
